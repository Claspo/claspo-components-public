{
  "name": "@claspo/components",
  "version": "1.1.20",
  "description": "",
  "scripts": {
    "prebuild": "rm -rf out",
    "build": "npm run prebuild && webpack",
    "dev": "npm run prebuild && npx cross-env dev=1 webpack --watch",
    "test": "jest --no-cache --config jest.config.js",
    "lint": "eslint",
    "bundle": "rm -rf out && npm i && npm run test && npm run build",
    "package": "npm run bundle && cp package.json LICENSE.md README.md out && cd out && npm publish --access=public && cd .."
  },
  "engines": {
    "node": ">=18.16.0"
  },
  "dependencies": {
    "@claspo/common": "6.0.0",
    "@claspo/renderer": "17.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "@babel/preset-env": "^7.27.2",
    "@eslint/js": "^9.28.0",
    "babel-jest": "^29.7.0",
    "babel-loader": "^10.0.0",
    "copy-webpack-plugin": "^13.0.0",
    "cross-env": "^10.0.0",
    "eslint": "^9.28.0",
    "globals": "^16.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.0.0-beta.3",
    "jsdom": "^26.1.0",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1"
  },
  "author": "alex-chernysh",
  "license": "LICENSE.md",
  "homepage": "https://docs.claspo.io/"
}
